<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ShopGuard-Automation-Suite" parallel="false">
    <listeners>
        <listener class-name="com.shopguard.reporting.TestListener"/>
    </listeners>

    <test name="UI-Tests">
        <classes>
            <class name="com.shopguard.ui.LoginTests"/>
            <class name="com.shopguard.ui.CheckoutTests"/>
        </classes>
    </test>

    <test name="API-Tests">
        <classes>
            <class name="com.shopguard.api.UserApiTests"/>
        </classes>
    </test>
</suite>